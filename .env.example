# Backend API base URL. Leave empty to use same-origin requests; set the
# Render service URL (for example https://flowmind-api.onrender.com) in Vercel.
# Never put the Activepieces webhook URL here.
VITE_API_URL=http://localhost:8000

# Kendi uluslararası formatta WhatsApp numaranızı ülke kodu ile girin (yalnızca rakam).
VITE_WHATSAPP_NUMBER=90XXXXXXXXXX

# Gerçek iletişim e-posta adresinizi buraya girin.
VITE_CONTACT_EMAIL=merhaba@alanadiniz.com
