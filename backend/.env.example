# Activepieces Webhook trigger URL. Keep the real value only in backend/.env.
ACTIVEPIECES_WEBHOOK_URL=
# SQLite file is stored relative to the backend directory.
DATABASE_PATH=./data/flowmind.db

# Local Vite origins. Add the deployed frontend origin before production.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

ACTIVEPIECES_TIMEOUT_SECONDS=8

# Gemini generation stays disabled until explicitly enabled in backend/.env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEMO_GENERATION_ENABLED=false
DEMO_DAILY_LIMIT=5
DEMO_MIN_INTERVAL_SECONDS=60
GEMINI_TIMEOUT_SECONDS=30
